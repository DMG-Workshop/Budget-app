# Copy to .env beside docker-compose.yml. Every value is optional; the
# defaults run everything locally with nothing leaving your network.

# local | anthropic | gemini | openai
COLDWATER_PROVIDER=local

# For the bundled Ollama container, leave these alone.
COLDWATER_LOCAL_FLAVOR=ollama
COLDWATER_BASE_URL=http://ollama:11434
COLDWATER_MODEL=llama3.1:8b

# Only for a cloud provider. Prefer setting this in the web UI instead, which
# writes it to the data volume with 0600 rather than leaving it in a file
# beside the compose config.
# COLDWATER_API_KEY=

# A shared secret for the web UI and API. Unset means no authentication,
# which is reasonable on a home network and is not once anyone else can
# reach the box.
# COLDWATER_TOKEN=

# ISO 4217. The model still prefers whatever the statement says.
# COLDWATER_CURRENCY=GBP

# Host ports for the proxy. The defaults are the real ones, which is what
# the phone apps expect. Rootless Podman cannot bind below 1024, so set
# these when running under Podman Desktop and use the port in the URL.
# COLDWATER_HTTP_PORT=8080
# COLDWATER_HTTPS_PORT=8443
